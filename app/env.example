# Plantilla de variables de entorno. Copiar a `.env` y completar con los valores reales:
#   cp env.example .env
# Los valores reales se comparten por VAULT (1Password/Bitwarden/etc.), nunca por git.
#
# Opcion A (recomendada): crear una Supabase propia y usar SUS claves (ver SETUP.md).
# Opcion B: usar la base compartida con las claves que te paso el otro tutor por vault.

# URL del proyecto Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon/publishable key -- con esta corre la app
VITE_SUPABASE_ANON_KEY=eyJh...tu-anon-key

# La clave service_role solo se usa en el entorno de la Edge Function.
# Nunca agregar claves secretas con prefijo VITE_: se incluyen en el navegador.
